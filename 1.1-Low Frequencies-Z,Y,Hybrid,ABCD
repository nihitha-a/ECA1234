clc;
clear;

% Given Z-parameters
Z11 = 10;
Z12 = 5;
Z21 = 5;
Z22 = 15;

Z = [Z11 Z12; Z21 Z22];

% Y-parameters
Y = inv(Z);

% h-parameters
h11 = (Z11*Z22-Z12*Z21)/Z22;
h12 = Z12/Z22;
h21 = -Z21/Z22;
h22 = 1/Z22;
H = [h11 h12; h21 h22];

% ABCD parameters
A = Z11/Z21;
B = (Z11*Z22-Z12*Z21)/Z21;
C = 1/Z21;
D = Z22/Z21;
ABCD = [A B; C D];

% Display
disp('Z Parameters ='); disp(Z);
disp('Y Parameters ='); disp(Y);
disp('Hybrid (h) Parameters ='); disp(H);
disp('ABCD Parameters ='); disp(ABCD);
