clc;
clear;
close all;

L = [5 10 15 20 25];

L_cm = L*1e-4;
vd = 1e7;

T = L_cm./vd;
f = 1./T;
f_GHz = f/1e9;
T_ps = T*1e12;

disp('Length(um)  Transit Time(ps)  Frequency(GHz)');
disp([L' T_ps' f_GHz']);

figure;
plot(L,f_GHz,'-o');
grid on;
xlabel('Active Region Length (um)');
ylabel('Frequency (GHz)');
title('Gunn Diode Oscillation Characteristics');
